# Multi-Tenant RAG System Environment Configuration

# ===== NEON DATABASE CONFIGURATION =====
# Catalog Database (Control Plane) - Main Neon project for tenant management
CATALOG_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/catalog_db?sslmode=require

# Neon API Configuration for creating tenant projects
NEON_API_KEY=neon_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEON_DEFAULT_REGION=aws-us-east-1

# ===== NEO4J / GRAPHITI CONFIGURATION =====
# Shared Neo4j instance for all tenants (with group_id namespacing)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ===== AUTHENTICATION & SECURITY =====
# JWT Secret for API key generation and validation
JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-in-production
JWT_ALGORITHM=HS256
API_KEY_EXPIRY_DAYS=365

# ===== EMBEDDINGS & AI SERVICES =====
# OpenAI for embeddings and chat completions
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_CHAT_MODEL=gpt-4-turbo-preview

# ===== APPLICATION CONFIGURATION =====
# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ===== MONITORING & OBSERVABILITY =====
# Optional: Add monitoring endpoints
ENABLE_METRICS=true
METRICS_PORT=9090

# ===== TENANT LIMITS & QUOTAS =====
# Default limits for new tenants
DEFAULT_MAX_DOCUMENTS=1000
DEFAULT_MAX_STORAGE_MB=500
DEFAULT_PLAN=basic
