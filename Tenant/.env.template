# Multi-Tenant RAG Prototype Environment Configuration
# Copy this to .env and update with your actual values

# ============================================================================
# NEON POSTGRESQL CONFIGURATION (Project-per-Tenant)
# ============================================================================

# Neon API key for creating projects (use mock for testing)
NEON_API_KEY=mock_neon_api_key_for_testing

# Catalog database connection string (SQLite for local testing)
CATALOG_DATABASE_URL=sqlite:///catalog.db

# ============================================================================
# NEO4J / GRAPHITI CONFIGURATION (Shared with Namespacing)
# ============================================================================

# Neo4j connection (for local Docker or cloud)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=prototype123

# For Neo4j AuraDB (alternative)
# NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_auradb_password

# ============================================================================
# AI API CONFIGURATION
# ============================================================================

# OpenAI API key (for embeddings and LLM)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key (alternative/additional)
GOOGLE_API_KEY=your_google_api_key_here

# Graphiti API key (if using Graphiti cloud)
GRAPHITI_API_KEY=your_graphiti_api_key_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment type
ENVIRONMENT=development

# API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# JWT Secret (change in production!)
JWT_SECRET_KEY=prototype-secret-key-change-in-production

# Logging level
LOG_LEVEL=INFO

# ============================================================================
# PROTOTYPE SPECIFIC SETTINGS
# ============================================================================

# Default region for new Neon projects
DEFAULT_NEON_REGION=aws-us-east-1

# Maximum tenants for prototype (safety limit)
MAX_PROTOTYPE_TENANTS=5

# Default tenant quotas
DEFAULT_MAX_DOCUMENTS=100
DEFAULT_MAX_STORAGE_MB=50

# ============================================================================
# DEVELOPMENT OVERRIDES (optional)
# ============================================================================

# For local development with mock services
# MOCK_NEON=true
# MOCK_NEO4J=true
